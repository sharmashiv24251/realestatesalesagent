# Google AI Studio Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Default model
GEMINI_MODEL=gemini-3.5-flash-lite

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:3002","http://127.0.0.1:3002"]
